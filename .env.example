PORT=3001
# Set to production for a real deployment.
NODE_ENV=development
# Optional exact public origin when your reverse proxy rewrites Host.
# Example: https://coalguard.your-organization.in (no path, no wildcard)
# With an https: origin, COOKIE_SECURE must be true or startup fails.
APP_ORIGIN=
# Which forwarding hops may be believed. Default is loopback (a proxy on this
# host). Accepted: false, 1-5 hops, loopback, linklocal, uniquelocal, or a
# comma-separated CIDR list such as 10.0.0.0/8,192.168.1.0/24.
# TRUST_PROXY=true is rejected: it would let any client forge X-Forwarded-For.
TRUST_PROXY=loopback
# Extra origins allowed to frame the interface. Non-demo production allows only
# 'self' unless you list hosts here. Example: https://portal.your-organization.in
FRAME_ANCESTORS=
# Maximum document extractions waiting in this process before uploads return 503.
MAX_PENDING_EXTRACTIONS=8
# Maximum simultaneous provider-backed AI requests in this process.
MAX_CONCURRENT_AI=4
DATABASE_PATH=./data/coalguard.sqlite
# Demo seeds fictional operational records, and permits one-click demo access.
# Never enable on a public production deployment.
DEMO_MODE=true
# Required with DEMO_MODE=false on first initialization (minimum 12 characters)
ADMIN_EMAIL=admin@your-organization.in
ADMIN_PASSWORD=
COOKIE_SECURE=false
# Only for a demo embedded in an HTTPS preview (e.g. Arena).
# Uses Secure, HttpOnly, SameSite=None, Partitioned cookies; leave false for normal deployments.
EMBEDDED_PREVIEW=false
# Optional demo-only troubleshooting: logs status/header-presence flags, never credentials.
AUTH_DIAGNOSTICS=false
# Fail-closed external AI activation. Demo mode ALWAYS blocks provider calls.
# Enable only in a private deployment with DEMO_MODE=false and controlled user access.
AI_ENABLED=false
# Exact approved provider hostnames, comma-separated. No wildcards.
AI_ALLOWED_HOSTS=openrouter.ai
# OpenAI-compatible chat/completions endpoints. Base URLs must use HTTPS.
# OpenRouter text assistant: use fictional demo data; provider may retain inputs/outputs.
# This template is shareable. Keep real keys in private backend configuration, never here.
AI_TEXT_BASE_URL=https://openrouter.ai/api/v1
# Supply either API_KEY through hosting secrets OR API_KEY_FILE via a secret mount.
# A file path is not encryption: production operators can still access the runtime.
AI_TEXT_API_KEY=
AI_TEXT_API_KEY_FILE=
AI_TEXT_MODEL=liquid/lfm-2.5-2.6b:free
AI_DECISION_BASE_URL=https://api.openai.com/v1
AI_DECISION_API_KEY=
AI_DECISION_API_KEY_FILE=
AI_DECISION_MODEL=
AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_API_KEY_FILE=
AI_EMBEDDING_MODEL=
# Optional Cohere-compatible /rerank endpoint (base URL includes /v2 if needed)
AI_RERANK_BASE_URL=https://api.cohere.com/v2
AI_RERANK_API_KEY=
AI_RERANK_API_KEY_FILE=
AI_RERANK_MODEL=

# ---------------------------------------------------------------------------
# PostgreSQL (optional). When DATABASE_URL is set, CoalGuard uses PostgreSQL
# instead of SQLite. The SQLite backend is used when DATABASE_URL is empty.
# ---------------------------------------------------------------------------
# Complete connection string. Example:
#   DATABASE_URL=postgresql://coalguard_user:secret@db.internal:5432/coalguard?sslmode=require
DATABASE_URL=

# Optional explicit connection settings (override DATABASE_URL parts).
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=

# TLS configuration for production PostgreSQL.
PG_SSL=false
PG_CA_CERT=
PG_CLIENT_CERT=
PG_CLIENT_KEY=

# Connection pool configuration.
PG_POOL_MAX=10
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONNECTION_TIMEOUT_MS=2000
PG_STATEMENT_TIMEOUT_MS=10000
PG_QUERY_TIMEOUT_MS=10000
PG_LOCK_TIMEOUT_MS=5000
